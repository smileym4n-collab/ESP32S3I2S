menu "USB to I2S DAC"

    choice AUDIO_SAMPLE_RATE_CHOICE
        prompt "Default USB/I2S sample rate"
        default AUDIO_SAMPLE_RATE_48000
        help
            Default rate used at boot before the USB host chooses a rate.
            The firmware advertises 44.1, 48, 88.2, and 96 kHz.

        config AUDIO_SAMPLE_RATE_44100
            bool "44.1 kHz"

        config AUDIO_SAMPLE_RATE_48000
            bool "48 kHz"

        config AUDIO_SAMPLE_RATE_88200
            bool "88.2 kHz"

        config AUDIO_SAMPLE_RATE_96000
            bool "96 kHz"
    endchoice

    config AUDIO_SAMPLE_RATE
        int
        default 44100 if AUDIO_SAMPLE_RATE_44100
        default 48000 if AUDIO_SAMPLE_RATE_48000
        default 88200 if AUDIO_SAMPLE_RATE_88200
        default 96000 if AUDIO_SAMPLE_RATE_96000

    choice AUDIO_BIT_DEPTH_CHOICE
        prompt "USB PCM bit depth"
        default AUDIO_BIT_DEPTH_16
        help
            16-bit is the reliable default with the managed Espressif
            usb_device_uac component. 24-bit is left available for custom
            descriptor work or component versions that expose 24-bit
            speaker descriptors.

        config AUDIO_BIT_DEPTH_16
            bool "16-bit stereo PCM"

        config AUDIO_BIT_DEPTH_24
            bool "24-bit stereo PCM (descriptor support required)"
    endchoice

    config AUDIO_BITS_PER_SAMPLE
        int
        default 16 if AUDIO_BIT_DEPTH_16
        default 24 if AUDIO_BIT_DEPTH_24

    config AUDIO_I2S_PORT
        int "I2S port"
        default 0
        range 0 1

    config AUDIO_I2S_BCLK_GPIO
        int "I2S BCLK GPIO"
        default 4
        help
            Board pin D4. Bit clock output to the DAC.

    config AUDIO_I2S_WS_GPIO
        int "I2S LRCK/WS GPIO"
        default 5
        help
            Board pin D5. LRCK/word-select output to the DAC.

    config AUDIO_I2S_DATA_GPIO
        int "I2S DATA GPIO"
        default 6
        help
            Set this to the board's serial data output pin feeding the DAC.

    config AUDIO_I2S_MCLK_GPIO
        int "I2S external SCK/MCLK input GPIO"
        default 15
        help
            Board pin D15. Selected oscillator from the 5PB1102PGGK clock
            buffer, used as the ESP32-S3 I2S external MCLK input when the
            ESP-IDF driver supports I2S_CLK_SRC_EXTERNAL.

    config AUDIO_OSC_SELECT_GPIO
        int "Oscillator select GPIO"
        default 17
        help
            Board pin D17. LOW selects 22.5792 MHz for 44.1/88.2 kHz.
            HIGH selects 24.5760 MHz for 48/96 kHz.

    config AUDIO_OSC_SELECT_INVERT
        bool "Invert oscillator select GPIO polarity"
        default n
        help
            Enable this if the oscillator mux inputs are wired opposite to the
            default firmware assumption. With this enabled, 44.1/88.2 kHz
            drives the select GPIO HIGH and 48/96 kHz drives it LOW.

    config AUDIO_I2S_DMA_DESC_NUM
        int "I2S DMA descriptor count"
        default 8
        range 4 16

    config AUDIO_I2S_DMA_FRAME_NUM
        int "I2S DMA frames per descriptor"
        default 240
        range 48 511
        help
            240 frames is 5 ms at 48 kHz and 2.5 ms at 96 kHz. Keep this
            below the ESP-IDF I2S driver's 511-frame limit.

    config AUDIO_STREAM_BUFFER_MS
        int "USB-to-I2S software buffer in ms"
        default 128
        range 20 250

    config AUDIO_PREFILL_MS
        int "Audio prefill before I2S start in ms"
        default 40
        range 2 100

    config AUDIO_IDLE_STOP_MS
        int "Stop I2S after no USB audio for this many ms"
        default 1000
        range 50 2000

    config AUDIO_TEST_TONE
        bool "Generate 1 kHz I2S test tone instead of USB audio"
        default n
        help
            Bypass USB audio data and write a simple stereo test tone to the
            I2S DAC path. Use this only for board bring-up diagnostics.

endmenu
